{
  "name": "jdelight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "cross-env-shell NEXT_TELEMETRY_DISABLED=1 \"next typegen && tsc --noEmit\"",
    "lint": "cross-env-shell NEXT_TELEMETRY_DISABLED=1 \"eslint . --max-warnings 0 && npm run format:check\"",
    "format": "cross-env NEXT_TELEMETRY_DISABLED=1 prettier --write .",
    "format:check": "cross-env NEXT_TELEMETRY_DISABLED=1 prettier --check .",
    "test": "cross-env NEXT_TELEMETRY_DISABLED=1 vitest run",
    "test:install": "cross-env NEXT_TELEMETRY_DISABLED=1 PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "test:e2e": "cross-env NEXT_TELEMETRY_DISABLED=1 PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test",
    "check": "cross-env-shell NEXT_TELEMETRY_DISABLED=1 \"npm run typecheck && npm run lint && npm run test && npm run build && npm run scan:client && npm run test:e2e\"",
    "quality": "node --experimental-transform-types --conditions=react-server --env-file-if-exists=.env.local scripts/quality.mjs",
    "scan:client": "node scripts/scan-client.mjs",
    "setup:env": "node --conditions=react-server scripts/setup-env.mjs",
    "codes:new": "node --experimental-transform-types --conditions=react-server scripts/codes-new.mjs",
    "trial:selfcheck": "node --experimental-transform-types --conditions=react-server scripts/trial-selfcheck.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "dexie": "4.4.6",
    "jsonrepair": "3.15.0",
    "motion": "14.5.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
