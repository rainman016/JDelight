# 仅由用户本人填写施工文件夹的 .env.local；不把密钥贴入对话。
EASYROUTER_API_KEY=
# 官方 OpenAI 兼容地址：https://easyrouter.io/v1
EASYROUTER_BASE_URL=
# 本工单限定型号：deepseek-flash
EASYROUTER_MODEL=
# 仓库之外的绝对 JSON 路径；首次使用复制 fixtures/empty-ledger.json 到该位置。
JDELIGHT_LEDGER_PATH=

# WO-004 试用模式：仅由用户在部署平台填写，以下值全部留空。
# 同时需要上方已有的 EASYROUTER 三项；试用不使用文件账本。
# HTTPS Redis REST 根地址与写权限令牌（推荐这一组）。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace 兼容名称：与上一组二选一，不混配。
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 逗号分隔的规范化邀请码 SHA-256 哈希，不填明文码。
JDELIGHT_INVITE_HASHES=
# 逗号分隔精确 Host，不含协议、路径或通配符。
JDELIGHT_ALLOWED_HOSTS=
